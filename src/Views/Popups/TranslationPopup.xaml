<Window x:Class="QuickLingo.Views.Popups.TranslationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickLingo.Views.Popups"
        Title="Результат перекладу"
        Height="250" Width="450"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#FF1E1E1E" CornerRadius="12" Padding="20" 
            Effect="{DynamicResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Результат перекладу" FontSize="18" Foreground="White" FontWeight="Bold" 
                       MouseDown="TitleBar_MouseDown" />

            <TextBox x:Name="ResultTextBox" Grid.Row="1"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     Background="#FF2D2D30"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="16"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"
                     Margin="0,10,0,10"
                     />

            <Button Grid.Row="2" Width="115" Height="35" HorizontalAlignment="Right" Cursor="Hand"
                    Click="CloseButton_Click" Background="#FF0078D7" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF003E6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                Закрити
            </Button>
        </Grid>
    </Border>
    
</Window>
